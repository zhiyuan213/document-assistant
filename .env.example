# 本机配置模板；数据库密码只填写在未提交的 .env 中
DB_PASSWORD=local-development-only
MYSQL_ROOT_PASSWORD=local-root-only
CORS_ORIGIN=http://127.0.0.1:5173
PDF_BILLING_ENABLED=false
PDF_MONTHLY_PRICE_FEN=990
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_MCH_PRIVATE_KEY_BASE64=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_PLATFORM_CERT_BASE64=
WECHAT_PAY_NOTIFY_URL=https://your-domain.example/api/pdf/pay/notify
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 测试时跳过 AI 付费额度校验，不扣用户额度；DeepSeek 仍按实际用量收费
PDF_AI_TEST_MODE=false
PDF_AI_MONTHLY_TOKEN_CREDITS=2000000
PDF_AI_DAILY_REQUEST_LIMIT=50
PDF_AI_MAX_PAGES=30
PDF_AI_MAX_SCAN_PAGES=5
PDF_AI_MAX_INPUT_CHARS=15000
PDF_AI_MAX_OUTPUT_TOKENS=1500
